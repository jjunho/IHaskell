{
  "name": "jupyterlab-ihaskell",
  "version": "0.0.14",
  "description": "adds ihaskell syntax highlighting to jupyterlab",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "ihaskell",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/gibiansky/IHaskell/",
  "bugs": {
    "url": "https://github.com/gibiansky/IHaskell/issues"
  },
  "license": "BSD-3-Clause",
  "author": "MMesch",
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:gibiansky/IHaskell.git"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@jupyterlab/application": ">=4.6.6",
    "@jupyterlab/codemirror": ">=4.6.6",
    "@jupyterlab/apputils": ">=4.7.6",
    "@jupyterlab/notebook": ">=4.6.6"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "@types/codemirror": ">=5.60.18",
    "@jupyterlab/builder": ">=4.5.11"
  },
  "resolutions": {
    "katex": "^0.18.11",
    "sanitize-html": "^2.18.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "webpackConfig": "./webpack.config.js"
  }
}
